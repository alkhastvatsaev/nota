{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/logiciel-serrurier",
      "destination": "/logiciel-interventions-terrain",
      "permanent": true
    },
    {
      "source": "/depannage-interventions",
      "destination": "/interventions-terrain",
      "permanent": true
    },
    {
      "source": "/facturation-depannage",
      "destination": "/facturation-interventions",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|google985da6a6498bd3a5\\.html|robots\\.txt|sitemap\\.xml|favicon|og-image|product/|.*\\.(png|svg|ico|webp|webmanifest|html|txt|xml)).*)",
      "destination": "/index.html"
    }
  ],
  "cleanUrls": false,
  "trailingSlash": false
}
